# .env.example

# Project Configuration
PROJECT_NAME=VideoDiscovery
DEBUG=True

# MongoDB Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/videodiscovery?retryWrites=true&w=majority
DATABASE_NAME=videodiscovery

# JWT Secret (generate a secure random string)
JWT_SECRET=your-secret-key-here-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-here-change-this-in-production

# Token Expiration Settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
FRONTEND_URL=http://localhost:5173

# LLM Configuration (Groq API)
LLM_API_KEY=your-groq-api-key

# Google Colab & YouTube API
COLAB_URL=https://your-colab-url.com
YOUTUBE_API_KEY=your-youtube-api-key

# Upload Limits
MAX_UPLOAD_SIZE_MB=100
